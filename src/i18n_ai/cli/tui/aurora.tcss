/* The frame every screen sits in, and the kit's pieces, in the aurora theme. */

Screen { background: $background; }

/* The shell */
#frame { height: 1fr; }
#sidebar {
    width: 24; height: 1fr; padding: 1 1; background: $panel;
    border-right: vkey $border-blurred;
}
#sidebar > .option-list--option-highlighted { background: $border-blurred; color: $foreground; text-style: bold; }
ShellScreen.-narrow #sidebar { width: 6; padding: 1 0 1 1; }
#main { width: 1fr; }
#command-bar { height: 1; padding: 0 2; background: $background; }
#crumb { width: auto; }
#palette { width: auto; margin-left: 3; color: $text-muted; }
#switcher { dock: right; width: 40; }
#body { height: 1fr; padding: 0 1; }
#notice { display: none; width: 1fr; height: 1fr; content-align: center middle; color: $warning; }
ShellScreen.-small #body { display: none; }
ShellScreen.-small #notice { display: block; }
#status { height: 1; background: $panel; }
#status-tree { width: auto; padding: 0 2; color: $text-muted; }
#status Footer { dock: none; width: 1fr; background: $panel; }

/* Cards and figures */
.card {
    height: auto; padding: 0 1; background: $surface;
    border: round $border; border-title-color: $foreground; border-title-style: bold;
}
.card.-fill { height: 1fr; }
.card.-accent { border: round $primary 50%; border-title-color: $primary; }
.kpi { width: 1fr; }
.kpi-label { color: $text-muted; text-style: bold; }
.kpi-value { text-style: bold; }
.kpi-value.-warning { color: $warning; }
.kpi-note { color: $text-muted; }

/* Chips */
.chip { width: auto; padding: 0 1; text-style: bold; color: $background; }
.chip.-primary { background: $primary; }
.chip.-secondary { background: $secondary; }
.chip.-accent { background: $accent; }
.chip.-warning { background: $warning; }
.chip.-error { background: $error; }

/* The heat scale */
.heat { width: 1fr; padding: 0 1; text-style: bold; }
.heat.-heat-0 { background: $heat-0; color: $heat-0-text; }
.heat.-heat-1 { background: $heat-1; color: $heat-1-text; }
.heat.-heat-2 { background: $heat-2; color: $heat-2-text; }
.heat.-heat-3 { background: $heat-3; color: $heat-3-text; }
.heat.-heat-4 { background: $heat-4; color: $heat-4-text; }

/* Locale cards */
.locale-card { height: 5; padding: 0 0 0 1; background: $surface; border: round $border; }
.locale-card.-picked { background: $primary 12%; border: round $primary 60%; }
.locale-card:focus { border: heavy $primary; }
.locale-head { height: 1; }
.locale-code { width: auto; }
.locale-card.-picked .locale-code { color: $primary; }
.locale-direction { width: auto; margin-left: 1; padding: 0 1; background: $border-blurred; color: $text-muted; }
.locale-check { width: 1fr; text-align: right; color: $border-strong; }
.locale-card.-picked .locale-check { color: $primary; }
.locale-name, .locale-state { width: 1fr; text-wrap: nowrap; text-overflow: ellipsis; }
.locale-state.-tree { color: $success; }
.locale-state.-new { color: $secondary; }

/* The model card */
.model-card { height: auto; }

/* Plan cells */
.plan-cell { height: 5; padding: 0 1; background: $surface; border: round $border; }
.plan-cell.-new { background: $secondary 8%; border: round $secondary 40%; }
.plan-cell.-fill { background: $warning 6%; border: round $warning 30%; }
.plan-cell.-done { background: $success 6%; border: round $success 30%; }
.plan-cell.-off { background: $panel; border: dashed $border-strong; }
.plan-cell:focus { border: heavy $primary; }
.cell-head { height: 1; }
.cell-tag { width: auto; padding: 0 1; text-style: bold; }
.plan-cell.-new .cell-tag { background: $secondary 20%; color: $secondary; }
.plan-cell.-fill .cell-tag { background: $warning 20%; color: $warning; }
.plan-cell.-done .cell-tag { background: $success 20%; color: $success; }
.plan-cell.-off .cell-tag { background: $border-blurred; color: $text-muted; }
.cell-short { display: none; width: auto; margin-left: 1; text-style: bold; }
.cell-mark { width: 1fr; text-align: right; color: $primary; }
.plan-cell.-off .cell-mark { color: $text-muted; }
.cell-number { text-style: bold; }
.plan-cell.-done .cell-number { color: $success; }
.plan-cell.-off .cell-number { color: $text-muted; }
.cell-strip { height: 1; }
ShellScreen.-narrow .plan-cell { height: 4; }

/* Run cells: a job's state, its tint the state's colour */
.run-cell { height: 5; padding: 0 1; background: $surface; border: round $border; }
.run-cell .cell-tag { width: auto; text-style: bold; color: $text-muted; }
.run-cell .cell-detail { text-wrap: nowrap; text-overflow: ellipsis; }
.run-cell .cell-note { color: $text-muted; text-wrap: nowrap; text-overflow: ellipsis; }
.run-cell.-translating { border: round $secondary 50%; }
.run-cell.-translating .cell-tag { color: $secondary; }
.run-cell.-retry { background: $warning 6%; border: round $warning 50%; }
.run-cell.-retry .cell-tag { color: $warning; }
.run-cell.-written { background: $success 6%; border: round $success 30%; }
.run-cell.-written .cell-tag { color: $success; }
.run-cell.-partial, .run-cell.-refused { background: $warning 6%; border: round $warning 30%; }
.run-cell.-partial .cell-tag, .run-cell.-refused .cell-tag { color: $warning; }
.run-cell.-failed, .run-cell.-stopped { background: $error 6%; border: round $error 30%; }
.run-cell.-failed .cell-tag, .run-cell.-stopped .cell-tag { color: $error; }
.run-cell.-off, .run-cell.-ignored { background: $panel; border: dashed $border-strong; }
.run-cell:focus { border: heavy $primary; }
ShellScreen.-narrow .run-cell { height: 4; }
ShellScreen.-narrow .run-cell .cell-note { display: none; }

/* The cell grid: the locales' headers and the files' names held while the cells scroll */
CellGrid { height: 1fr; }
#grid-top { height: auto; }
.grid-corner { width: 24; color: $text-muted; text-style: bold; padding: 1 0 0 0; }
#locale-strip { height: auto; overflow: hidden hidden; padding-right: 1; }
#grid-body { height: 1fr; }
#file-column { width: 24; overflow: hidden hidden; }
#cells { scrollbar-gutter: stable; scrollbar-size-vertical: 1; }
.columns { height: auto; grid-gutter: 0 1; }
.column-head { height: 3; padding: 0 1; background: $panel; border: round $border-blurred; }
.column-head-name { width: 1fr; text-wrap: nowrap; text-overflow: ellipsis; }
.column-head-count { width: auto; color: $text-muted; }
.file-head { height: 5; padding: 1 0 0 1; }
.file-head-note { color: $text-muted; }
ShellScreen.-narrow .column-head { height: 1; border: none; }
ShellScreen.-narrow .file-head { height: 4; }
ShellScreen.-narrow .grid-corner { padding: 0; }

/* The plan's run bar */
#run-bar { background: $panel; border: round $border; }
ShellScreen.-narrow #run-bar { border: none; }
ShellScreen.-narrow .cell-number { display: none; }
ShellScreen.-narrow .cell-short { display: block; }

/* The run screen */
#done-label { color: $text-muted; text-style: bold; }
#done-percent { text-style: bold; color: $primary; }
.event { margin-bottom: 1; }
